# Database
# 本番は Supabase の接続文字列。ローカルは `make dev` が Docker で立てる Postgres を使う:
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/oshi?schema=public

# LINE ログイン（NextAuth）。LINE Developers の「LINEログイン」チャネルの値。
# コールバック URL に http://localhost:3000/api/auth/callback/line を登録すること。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE Messaging API（通知送信用）。「Messaging API」チャネルの長期アクセストークン。
# ログインには不要。クローラーのプッシュ通知でのみ使う。
LINE_CHANNEL_ACCESS_TOKEN=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
